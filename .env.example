# ---------------------------------------------------------------------------
# Zoa Waste Hub — environment
#
# Payment, SMS, USSD, email and translation keys are NOT set here: an admin
# enters them in the app under Settings, where they're encrypted at rest.
# ---------------------------------------------------------------------------

# Signing key for session JWTs (HS256).
# Optional in development — a built-in dev key is used if unset.
# REQUIRED in production: the server refuses to sign tokens without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# PostgreSQL connection string. REQUIRED in production.
# Leave unset in development to use the built-in PGlite database (real
# Postgres in WebAssembly, stored under .data/pglite — nothing to install).
# Example: postgres://user:password@host:5432/zoa
DATABASE_URL=

# Key for encrypting integration secrets saved in Settings (64 hex chars).
# Optional: without it a key is derived from SESSION_SECRET. Changing either
# means re-entering saved keys. Generate like SESSION_SECRET above.
SETTINGS_ENCRYPTION_KEY=

# Shared secret for the scheduled billing job (monthly charges + reminders).
# Call it daily:  curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://<host>/api/cron/billing
CRON_SECRET=

# Optional fallback for the public HTTPS address Safaricom and Africa's
# Talking call back to. Normally set in Settings → Public address instead.
PUBLIC_BASE_URL=

# --- development / demo only -------------------------------------------------

# Where PGlite stores its data when DATABASE_URL is unset.
# PGLITE_DIR=.data/pglite

# Allow the embedded database under NODE_ENV=production (demos only).
# ALLOW_EMBEDDED_DB=1

# Show sign-in/reset codes on screen when SMS and email aren't connected, even
# in production. Never enable this on a real deployment.
# ALLOW_DEMO_CODES=1
